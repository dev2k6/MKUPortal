<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Screen Content -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/mainCoordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mku_bg_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Top App Bar / Header -->
            <include layout="@layout/layout_top_toolbar" />

            <!-- Main Content Scroll -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nestedScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="40dp">

                    <!-- Section Title: Arrow Icon + THỜI KHÓA BIỂU -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="@string/desc_settings"
                            android:src="@drawable/ic_arrow_circle_right" />

                        <TextView
                            android:id="@+id/tvHeaderTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:letterSpacing="0.02"
                            android:text="@string/title_schedules"
                            android:textColor="@color/mku_title_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Divider below section title -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/mku_divider" />

                    <!-- Tab Bar Header -->
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayoutSchedules"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        app:tabIndicatorColor="#FF2A6D"
                        app:tabIndicatorHeight="3dp"
                        app:tabSelectedTextColor="@color/mku_title_blue"
                        app:tabTextColor="@color/mku_text_sub">

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_tab_week" />

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_tab_period" />

                    </com.google.android.material.tabs.TabLayout>

                    <!-- Tab 1 Container: TKB TUẦN -->
                    <LinearLayout
                        android:id="@+id/containerTabWeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <!-- Filter Card Week -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/mku_card_bg"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="1dp"
                            app:strokeColor="@color/mku_card_stroke"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/label_year_study"
                                    app:boxStrokeColor="@color/mku_primary_blue">

                                    <AutoCompleteTextView
                                        android:id="@+id/spinnerYearWeek"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="none"
                                        android:textColor="@color/mku_text_header"
                                        android:textSize="15sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:hint="@string/label_term"
                                    app:boxStrokeColor="@color/mku_primary_blue">

                                    <AutoCompleteTextView
                                        android:id="@+id/spinnerTermWeek"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="none"
                                        android:textColor="@color/mku_text_header"
                                        android:textSize="15sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:hint="@string/label_week"
                                    app:boxStrokeColor="@color/mku_primary_blue">

                                    <AutoCompleteTextView
                                        android:id="@+id/spinnerWeekSchedule"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="none"
                                        android:textColor="@color/mku_text_header"
                                        android:textSize="15sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <!-- Nav Buttons Row -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="20dp"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnPrevWeek"
                                        style="@style/Widget.Material3.Button"
                                        android:layout_width="56dp"
                                        android:layout_height="44dp"
                                        android:text="@string/btn_prev_week"
                                        android:textColor="@color/white"
                                        android:textSize="16sp"
                                        app:backgroundTint="@color/mku_primary_blue"
                                        app:cornerRadius="6dp" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnCurrentWeek"
                                        style="@style/Widget.Material3.Button"
                                        android:layout_width="wrap_content"
                                        android:layout_height="44dp"
                                        android:layout_marginStart="12dp"
                                        android:layout_marginEnd="12dp"
                                        android:text="@string/btn_current_week"
                                        android:textColor="@color/white"
                                        android:textSize="14sp"
                                        app:backgroundTint="@color/mku_primary_blue"
                                        app:cornerRadius="6dp" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnNextWeek"
                                        style="@style/Widget.Material3.Button"
                                        android:layout_width="56dp"
                                        android:layout_height="44dp"
                                        android:text="@string/btn_next_week"
                                        android:textColor="@color/white"
                                        android:textSize="16sp"
                                        app:backgroundTint="@color/mku_primary_blue"
                                        app:cornerRadius="6dp" />

                                </LinearLayout>

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Weekly Grid Schedule Horizontal Scroll -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:overScrollMode="never">

                            <LinearLayout
                                android:id="@+id/containerWeekGrid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />

                        </HorizontalScrollView>

                    </LinearLayout>

                    <!-- Tab 2 Container: TKB THỨ - TIẾT -->
                    <LinearLayout
                        android:id="@+id/containerTabPeriod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <!-- Filter Card Period -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/mku_card_bg"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="1dp"
                            app:strokeColor="@color/mku_card_stroke"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/label_year_study"
                                    app:boxStrokeColor="@color/mku_primary_blue">

                                    <AutoCompleteTextView
                                        android:id="@+id/spinnerYearPeriod"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="none"
                                        android:textColor="@color/mku_text_header"
                                        android:textSize="15sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:hint="@string/label_term"
                                    app:boxStrokeColor="@color/mku_primary_blue">

                                    <AutoCompleteTextView
                                        android:id="@+id/spinnerTermPeriod"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="none"
                                        android:textColor="@color/mku_text_header"
                                        android:textSize="15sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <!-- Red Summary Text -->
                                <TextView
                                    android:id="@+id/tvSummaryPeriod"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:textColor="#E53935"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    tools:text="Năm học: 2025-2026 - Học kỳ: HK03" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Period Schedule Table Horizontal Scroll -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:overScrollMode="never">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="@color/mku_card_bg"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="1dp"
                                app:strokeColor="@color/mku_card_stroke"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <!-- Table Header Row -->
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minHeight="48dp"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:paddingStart="12dp"
                                        android:paddingEnd="12dp"
                                        android:paddingTop="12dp"
                                        android:paddingBottom="12dp">

                                        <TextView
                                            android:layout_width="40dp"
                                            android:layout_height="wrap_content"
                                            android:gravity="center"
                                            android:text="@string/label_stt"
                                            android:textColor="@color/mku_text_header"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="220dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="@string/label_col_lhp_name"
                                            android:textColor="@color/mku_text_header"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="90dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_room"
                                            android:textColor="@color/mku_text_header"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="140dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_weeks"
                                            android:textColor="@color/mku_text_header"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="60dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_campus"
                                            android:textColor="@color/mku_text_header"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="100dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="@string/label_col_address"
                                            android:textColor="@color/mku_text_header"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                    </LinearLayout>

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:background="@color/mku_divider" />

                                    <!-- Rows Container -->
                                    <LinearLayout
                                        android:id="@+id/containerPeriodRows"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical" />

                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                        </HorizontalScrollView>

                    </LinearLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

        <!-- Floating Action Button (bottom right) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/desc_settings"
            app:backgroundTint="@color/fab_bg"
            app:elevation="4dp"
            app:fabSize="normal"
            app:srcCompat="@drawable/ic_tune_fab"
            app:tint="@color/white" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Side Navigation Drawer Panel -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/navigationDrawerPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/mku_card_bg"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Drawer Header (Logo + Student Profile) -->
            <include layout="@layout/layout_drawer_header" />

            <!-- Dynamic Menu List Container -->
            <LinearLayout
                android:id="@+id/containerDrawerMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.drawerlayout.widget.DrawerLayout>