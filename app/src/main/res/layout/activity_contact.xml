<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Screen Content -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/mainCoordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mku_bg_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Top App Bar / Header -->
            <include layout="@layout/layout_top_toolbar" />

            <!-- Main Content Scroll -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nestedScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="40dp">

                    <!-- Section Title: Arrow Icon + LIÊN HỆ - GÓP Ý -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="@string/desc_settings"
                            android:src="@drawable/ic_arrow_circle_right" />

                        <TextView
                            android:id="@+id/tvHeaderTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:letterSpacing="0.02"
                            android:text="@string/title_contact_header"
                            android:textColor="@color/mku_title_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Divider below section title -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/mku_divider" />

                    <!-- Form Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/mku_card_bg"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/mku_card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <!-- 1. Phòng ban Spinner -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilDepartment"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_department"
                                app:boxStrokeColor="@color/mku_primary_blue">

                                <AutoCompleteTextView
                                    android:id="@+id/spinnerDepartment"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"
                                    android:textColor="@color/mku_text_header"
                                    android:textSize="15sp" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- 2. Tiêu đề -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilContactSubject"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:hint="@string/hint_subject"
                                app:boxStrokeColor="@color/mku_primary_blue">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etContactSubject"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text"
                                    android:textColor="@color/mku_text_header"
                                    android:textSize="15sp" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Label: Nội dung -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="@string/hint_content"
                                android:textColor="@color/mku_text_sub"
                                android:textSize="14sp" />

                            <!-- Rich Editor Container Box -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                app:cardBackgroundColor="@color/mku_card_bg"
                                app:cardCornerRadius="6dp"
                                app:cardElevation="0dp"
                                app:strokeColor="@color/mku_card_stroke"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <!-- Format Toolbar -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="#F8FAFC"
                                        android:orientation="vertical"
                                        android:padding="10dp">

                                        <!-- Normal Style Dropdown Selector -->
                                        <TextView
                                            android:id="@+id/tvFormatStyle"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:padding="4dp"
                                            android:text="Normal ▾"
                                            android:textColor="@color/mku_text_header"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <!-- Format Action Buttons Row -->
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="6dp"
                                            android:gravity="center_vertical"
                                            android:orientation="horizontal">

                                            <TextView
                                                android:id="@+id/btnFormatBold"
                                                android:layout_width="32dp"
                                                android:layout_height="32dp"
                                                android:gravity="center"
                                                android:text="B"
                                                android:textColor="@color/mku_text_header"
                                                android:textSize="15sp"
                                                android:textStyle="bold" />

                                            <TextView
                                                android:id="@+id/btnFormatItalic"
                                                android:layout_width="32dp"
                                                android:layout_height="32dp"
                                                android:layout_marginStart="8dp"
                                                android:gravity="center"
                                                android:text="I"
                                                android:textColor="@color/mku_text_header"
                                                android:textSize="15sp"
                                                android:textStyle="italic" />

                                            <TextView
                                                android:id="@+id/btnFormatUnderline"
                                                android:layout_width="32dp"
                                                android:layout_height="32dp"
                                                android:layout_marginStart="8dp"
                                                android:gravity="center"
                                                android:text="U"
                                                android:textColor="@color/mku_text_header"
                                                android:textSize="15sp" />

                                            <TextView
                                                android:id="@+id/btnFormatLink"
                                                android:layout_width="32dp"
                                                android:layout_height="32dp"
                                                android:layout_marginStart="8dp"
                                                android:gravity="center"
                                                android:text="🔗"
                                                android:textColor="@color/mku_text_header"
                                                android:textSize="14sp" />

                                            <TextView
                                                android:id="@+id/btnFormatOrderedList"
                                                android:layout_width="32dp"
                                                android:layout_height="32dp"
                                                android:layout_marginStart="8dp"
                                                android:gravity="center"
                                                android:text="123"
                                                android:textColor="@color/mku_text_header"
                                                android:textSize="12sp"
                                                android:textStyle="bold" />

                                            <TextView
                                                android:id="@+id/btnFormatBulletList"
                                                android:layout_width="32dp"
                                                android:layout_height="32dp"
                                                android:layout_marginStart="8dp"
                                                android:gravity="center"
                                                android:text="•≡"
                                                android:textColor="@color/mku_text_header"
                                                android:textSize="14sp" />

                                            <TextView
                                                android:id="@+id/btnFormatClear"
                                                android:layout_width="32dp"
                                                android:layout_height="32dp"
                                                android:layout_marginStart="8dp"
                                                android:gravity="center"
                                                android:text="T_x"
                                                android:textColor="@color/mku_text_header"
                                                android:textSize="12sp" />

                                        </LinearLayout>

                                    </LinearLayout>

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:background="@color/mku_divider" />

                                    <!-- Multiline Content Field -->
                                    <EditText
                                        android:id="@+id/etContactContent"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@android:color/transparent"
                                        android:gravity="top|start"
                                        android:hint="@string/hint_content"
                                        android:inputType="textMultiLine"
                                        android:minHeight="180dp"
                                        android:padding="14dp"
                                        android:textColor="@color/mku_text_header"
                                        android:textSize="15sp" />

                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- Submit Button (Gửi) -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:gravity="end"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnSubmitContact"
                                    android:layout_width="100dp"
                                    android:layout_height="46dp"
                                    android:backgroundTint="@color/mku_primary_blue"
                                    android:text="@string/btn_send"
                                    android:textColor="@color/white"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="6dp" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

        <!-- Floating Action Button (bottom right) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/desc_settings"
            app:backgroundTint="@color/fab_bg"
            app:elevation="4dp"
            app:fabSize="normal"
            app:srcCompat="@drawable/ic_tune_fab"
            app:tint="@color/white" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Side Navigation Drawer Panel -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/navigationDrawerPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/mku_card_bg"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/layout_drawer_header" />

            <LinearLayout
                android:id="@+id/containerDrawerMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="16dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
