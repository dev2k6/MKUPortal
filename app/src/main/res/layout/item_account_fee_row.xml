<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="950dp"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="950dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvFeeName"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:textColor="@color/mku_text_header"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvRegistType"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:textColor="@color/mku_text_body"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDebtAmount"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:textColor="@color/mku_text_body"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvPaidAmount"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:textColor="@color/mku_text_body"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDaGiam"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:textColor="@color/mku_text_body"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvConNo"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:textColor="@color/mku_text_body"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvPaidDate"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:textColor="@color/mku_text_body"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvNoiDungThu"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/mku_text_body"
            android:textSize="13sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/mku_divider" />

</LinearLayout>