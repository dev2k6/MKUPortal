<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/mku_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/mku_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mku_text_header"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Chi tiết thông báo" />

        <TextView
            android:id="@+id/tvDetailSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/mku_text_sub"
            android:textSize="13sp"
            tools:text="Người gửi: KHTC | Ngày: 02/09/2026" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/mku_divider" />

        <TextView
            android:id="@+id/tvDetailBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/mku_text_body"
            android:textSize="15sp"
            tools:text="Nội dung thông báo..." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseDetail"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="20dp"
            android:text="@string/btn_close"
            android:textColor="@color/mku_primary_blue"
            app:strokeColor="@color/mku_primary_blue"
            app:strokeWidth="1dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>