<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvStt"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/mku_text_body"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvCourseCode"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/mku_text_body"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvCourseTitle"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/mku_text_header"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvCredits"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:textColor="@color/mku_text_body"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvGrade10"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:textColor="@color/mku_text_body"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvGrade4"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:textColor="@color/mku_text_body"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvGradeChar"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:textColor="@color/mku_title_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgPass"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/label_col_result"
                android:src="@drawable/ic_check_circle" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/btnExpandDetail"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_circle_chevron"
                android:clickable="true"
                android:contentDescription="@string/label_col_detail"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/ic_chevron_down" />

        </LinearLayout>

    </LinearLayout>

    <!-- Expanded Detail Container -->
    <LinearLayout
        android:id="@+id/containerDetailBreakdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mku_divider"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/mku_divider" />

</LinearLayout>