<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Screen Content -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/mainCoordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mku_bg_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Top App Bar / Header -->
            <include layout="@layout/layout_top_toolbar" />

            <!-- Main Content Scroll -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nestedScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="40dp">

                    <!-- Section Title: Arrow Icon + LỊCH THI -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="@string/desc_settings"
                            android:src="@drawable/ic_arrow_circle_right" />

                        <TextView
                            android:id="@+id/tvHeaderTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:letterSpacing="0.02"
                            android:text="@string/title_exam"
                            android:textColor="@color/mku_title_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Divider below section title -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/mku_divider" />

                    <!-- Tab Bar Header -->
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayoutExam"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        app:tabIndicatorColor="#FF2A6D"
                        app:tabIndicatorHeight="3dp"
                        app:tabSelectedTextColor="@color/mku_title_blue"
                        app:tabTextColor="@color/mku_text_sub">

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_tab_year_term" />

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_tab_date_range" />

                    </com.google.android.material.tabs.TabLayout>

                    <!-- Notice Card (Lưu ý:) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="@color/mku_card_bg"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/mku_card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Lưu ý:"
                                android:textColor="@color/mku_text_header"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/notice_exam_content"
                                android:textColor="@color/mku_text_sub"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Filter Dropdowns Card (Năm học, Học kỳ) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="@color/mku_card_bg"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/mku_card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/label_year_study"
                                app:boxStrokeColor="@color/mku_primary_blue">

                                <AutoCompleteTextView
                                    android:id="@+id/spinnerYearExam"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"
                                    android:textColor="@color/mku_text_header"
                                    android:textSize="15sp" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:hint="@string/label_term"
                                app:boxStrokeColor="@color/mku_primary_blue">

                                <AutoCompleteTextView
                                    android:id="@+id/spinnerTermExam"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"
                                    android:textColor="@color/mku_text_header"
                                    android:textSize="15sp" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- SECTION 1: Lịch chưa thi -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_upcoming_exams"
                            android:textColor="@color/mku_text_sub"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="120dp"
                            android:layout_height="3dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="12dp"
                            android:background="#A0A0A0" />

                        <!-- Upcoming Exams Table Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/mku_card_bg"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="1dp"
                            app:strokeColor="@color/mku_card_stroke"
                            app:strokeWidth="1dp">

                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:overScrollMode="never"
                                android:scrollbars="horizontal">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <!-- Table Header Row -->
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="#F8FAFC"
                                        android:orientation="horizontal"
                                        android:paddingStart="12dp"
                                        android:paddingTop="14dp"
                                        android:paddingEnd="12dp"
                                        android:paddingBottom="14dp">

                                        <TextView
                                            android:layout_width="220dp"
                                            android:layout_height="wrap_content"
                                            android:text="@string/label_col_lhp_name"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="60dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_sbd"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="70dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_lan_thi"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="90dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_ngay_thi"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="80dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_gio_thi"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="80dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_phong_thi"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="100dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="@string/label_col_hinh_thuc_thi"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="140dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="@string/label_col_ky_thi"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="100dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="@string/label_col_ghi_chu"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="70dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_vang_thi"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="80dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_link"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                    </LinearLayout>

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:background="@color/mku_divider" />

                                    <!-- Upcoming Data Rows Container -->
                                    <LinearLayout
                                        android:id="@+id/containerUpcomingExamRows"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical" />

                                </LinearLayout>

                            </HorizontalScrollView>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- SECTION 2: Tất cả -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_all"
                            android:textColor="@color/mku_text_sub"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="60dp"
                            android:layout_height="3dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="12dp"
                            android:background="#A0A0A0" />

                        <!-- All Exams Table Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/mku_card_bg"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="1dp"
                            app:strokeColor="@color/mku_card_stroke"
                            app:strokeWidth="1dp">

                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:overScrollMode="never"
                                android:scrollbars="horizontal">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <!-- Table Header Row -->
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="#F8FAFC"
                                        android:orientation="horizontal"
                                        android:paddingStart="12dp"
                                        android:paddingTop="14dp"
                                        android:paddingEnd="12dp"
                                        android:paddingBottom="14dp">

                                        <TextView
                                            android:layout_width="220dp"
                                            android:layout_height="wrap_content"
                                            android:text="@string/label_col_lhp_name"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="60dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_sbd"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="70dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_lan_thi"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="90dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_ngay_thi"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="80dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_gio_thi"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="80dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_phong_thi"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="100dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="@string/label_col_hinh_thuc_thi"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="140dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="@string/label_col_ky_thi"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="100dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="@string/label_col_ghi_chu"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="70dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_vang_thi"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="80dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_link"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                    </LinearLayout>

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:background="@color/mku_divider" />

                                    <!-- All Data Rows Container -->
                                    <LinearLayout
                                        android:id="@+id/containerAllExamRows"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical" />

                                </LinearLayout>

                            </HorizontalScrollView>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

        <!-- Floating Action Button (bottom right) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/desc_settings"
            app:backgroundTint="@color/fab_bg"
            app:elevation="4dp"
            app:fabSize="normal"
            app:srcCompat="@drawable/ic_tune_fab"
            app:tint="@color/white" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Side Navigation Drawer Panel -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/navigationDrawerPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/mku_card_bg"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/layout_drawer_header" />

            <LinearLayout
                android:id="@+id/containerDrawerMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="16dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
