<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Screen Content -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/mainCoordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mku_bg_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Top App Bar / Header -->
            <include layout="@layout/layout_top_toolbar" />

            <!-- Main Content Scroll -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nestedScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="40dp">

                    <!-- Section Title: Arrow Icon + CHI TIẾT HÓA ĐƠN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="@string/desc_settings"
                            android:src="@drawable/ic_arrow_circle_right" />

                        <TextView
                            android:id="@+id/tvHeaderTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:letterSpacing="0.02"
                            android:text="@string/title_order_detail"
                            android:textColor="@color/mku_title_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Divider below section title -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/mku_divider" />

                    <!-- Tab Bar Header -->
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayoutOrderDetail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        app:tabIndicatorColor="#FF2A6D"
                        app:tabIndicatorHeight="3dp"
                        app:tabSelectedTextColor="@color/mku_title_blue"
                        app:tabTextColor="@color/mku_text_sub">

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_tab_order_detail" />

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_tab_declaration" />

                    </com.google.android.material.tabs.TabLayout>

                    <!-- TAB 1 CONTENT: CHI TIẾT -->
                    <LinearLayout
                        android:id="@+id/containerTabDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <!-- Filters Card (Năm học, Học kỳ) -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/mku_card_bg"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="1dp"
                            app:strokeColor="@color/mku_card_stroke"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/label_year_study"
                                    app:boxStrokeColor="@color/mku_primary_blue">

                                    <AutoCompleteTextView
                                        android:id="@+id/spinnerYearOrder"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="none"
                                        android:textColor="@color/mku_text_header"
                                        android:textSize="15sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:hint="@string/label_term"
                                    app:boxStrokeColor="@color/mku_primary_blue">

                                    <AutoCompleteTextView
                                        android:id="@+id/spinnerTermOrder"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="none"
                                        android:textColor="@color/mku_text_header"
                                        android:textSize="15sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Horizontal Scroll Table Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:cardBackgroundColor="@color/mku_card_bg"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="1dp"
                            app:strokeColor="@color/mku_card_stroke"
                            app:strokeWidth="1dp">

                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:overScrollMode="never"
                                android:scrollbars="horizontal">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <!-- Table Header Row -->
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="#F8FAFC"
                                        android:orientation="horizontal"
                                        android:paddingStart="12dp"
                                        android:paddingTop="14dp"
                                        android:paddingEnd="12dp"
                                        android:paddingBottom="14dp">

                                        <TextView
                                            android:layout_width="80dp"
                                            android:layout_height="wrap_content"
                                            android:text="@string/label_col_invoice_no"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="180dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="@string/label_col_payment_content"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="130dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="@string/label_col_payment_date"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="120dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="@string/label_col_payment_method"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="110dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="end"
                                            android:text="@string/label_col_amount"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="120dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_e_invoice"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="80dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:text="@string/label_col_detail"
                                            android:textColor="@color/mku_title_blue"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                    </LinearLayout>

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:background="@color/mku_divider" />

                                    <!-- Data Rows Container -->
                                    <LinearLayout
                                        android:id="@+id/containerOrderRows"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical" />

                                </LinearLayout>

                            </HorizontalScrollView>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- TAB 2 CONTENT: KHAI BÁO -->
                    <LinearLayout
                        android:id="@+id/containerTabDeclaration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/mku_card_bg"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="1dp"
                            app:strokeColor="@color/mku_card_stroke"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilOrgName"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/hint_org_name"
                                    app:boxStrokeColor="@color/mku_primary_blue">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etOrgName"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="text"
                                        android:textColor="@color/mku_text_header"
                                        android:textSize="15sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilOrgAddress"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:hint="@string/hint_org_address"
                                    app:boxStrokeColor="@color/mku_primary_blue">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etOrgAddress"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="text"
                                        android:textColor="@color/mku_text_header"
                                        android:textSize="15sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilTaxCode"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:hint="@string/hint_tax_code"
                                    app:boxStrokeColor="@color/mku_primary_blue">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etTaxCode"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="text"
                                        android:textColor="@color/mku_text_header"
                                        android:textSize="15sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilDeclarationEmail"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:hint="@string/hint_declaration_email"
                                    app:boxStrokeColor="@color/mku_primary_blue">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etDeclarationEmail"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="textEmailAddress"
                                        android:textColor="@color/mku_text_header"
                                        android:textSize="15sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilBudgetCode"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:hint="@string/hint_budget_code"
                                    app:boxStrokeColor="@color/mku_primary_blue">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etBudgetCode"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="text"
                                        android:textColor="@color/mku_text_header"
                                        android:textSize="15sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <!-- Action Buttons Row -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="20dp"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnSaveDeclaration"
                                        android:layout_width="0dp"
                                        android:layout_height="48dp"
                                        android:layout_weight="1"
                                        android:backgroundTint="#2ECC71"
                                        android:text="@string/btn_update_declaration"
                                        android:textColor="@color/white"
                                        android:textSize="14sp"
                                        app:cornerRadius="6dp" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnClearDeclaration"
                                        android:layout_width="0dp"
                                        android:layout_height="48dp"
                                        android:layout_marginStart="12dp"
                                        android:layout_weight="1"
                                        android:backgroundTint="#FF2A6D"
                                        android:text="@string/btn_clear_declaration"
                                        android:textColor="@color/white"
                                        android:textSize="14sp"
                                        app:cornerRadius="6dp" />

                                </LinearLayout>

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

        <!-- Floating Action Button (bottom right) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/desc_settings"
            app:backgroundTint="@color/fab_bg"
            app:elevation="4dp"
            app:fabSize="normal"
            app:srcCompat="@drawable/ic_tune_fab"
            app:tint="@color/white" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Side Navigation Drawer Panel -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/navigationDrawerPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/mku_card_bg"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/layout_drawer_header" />

            <LinearLayout
                android:id="@+id/containerDrawerMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="16dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
