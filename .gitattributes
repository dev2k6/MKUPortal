# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized
*.kt text diff=kotlin
*.java text diff=java
*.xml text
*.gradle text
*.gradle.kts text diff=kotlin
*.properties text
*.json text
*.md text
*.txt text
*.pro text
*.toml text

# Shell scripts must always have LF line endings
*.sh text eol=lf
gradlew text eol=lf

# Windows Batch scripts must always have CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - prevent Git from modifying line endings
*.jar binary
*.aar binary
*.apk binary
*.aab binary
*.dex binary
*.class binary
*.so binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.svg text
*.keystore binary
*.jks binary

